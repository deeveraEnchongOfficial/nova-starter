APP_NAME="Nova Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://app.nova-starter.localhost

# Add LAN IP so other devices on the network can access the app with session auth
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,app.nova-starter.localhost,192.168.1.11,192.168.1.11:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

DB_CONNECTION=primary
DB_DSN=mongodb://dbuser:password@mongodb:27017
DB_DATABASE=nova_starter
DB_USERNAME=dbuser
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=uploads

# Max upload size in bytes (default: 524288000 = 500MB)
FILE_UPLOAD_MAX_SIZE=1073741824
# Total storage capacity in bytes (default: 50GB, shown in dashboard widget)
STORAGE_CAPACITY=53687091200
AWS_ENDPOINT=http://minio:9000
AWS_URL=https://storage.nova-starter.localhost/uploads
AWS_SIGNING_URL=https://storage.nova-starter.localhost
AWS_PRESIGNED_REQUEST_TTL=120
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Branding
APP_SHORT_NAME=Nova
APP_TAGLINE="Build faster, ship smarter."
APP_LOGO=
APP_LOGO_DARK=
APP_FAVICON=
APP_THEME_MODE=light
APP_PRIMARY_COLOR=neutral
APP_THEME_RADIUS=0.625rem

# Modules
MODULE_USERS_ENABLED=true
MODULE_ROLES_ENABLED=true
MODULE_SETTINGS_ENABLED=true

# Feature Toggles
FEATURE_USER_REGISTRATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_USER_PROFILE_EDIT=true
FEATURE_ACCOUNT_DELETION=true
FEATURE_API_TOKENS=false
FEATURE_DARK_MODE=true
FEATURE_ACTIVITY_LOGS=true
FEATURE_MULTI_TENANT=true

# Docker Local Ports
LOCAL_NOVA_APP_PORT=8000
LOCAL_NOVA_VITE_PORT=5173
LOCAL_NOVA_APP_XDEBUG_PORT=9003
LOCAL_NOVA_MONGODB_PORT=27017
LOCAL_NOVA_REDIS_PORT=6379
LOCAL_NOVA_MAILHOG_PORT=1025
LOCAL_NOVA_MAILHOG_DASHBOARD_PORT=8025
LOCAL_NOVA_MINIO_API_PORT=9000
LOCAL_NOVA_MINIO_CONSOLE_PORT=9001
LOCAL_NOVA_N8N_PORT=5678

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password
GENERIC_TIMEZONE=Asia/Manila

WWWUSER=1000
WWWGROUP=1000

# open router api
OPENROUTER_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
